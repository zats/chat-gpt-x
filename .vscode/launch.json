{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ChatGPTX: Rebuild and Run",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "/usr/bin/open",
      "runtimeArgs": [
        "${workspaceFolder}/.builds/ChatGPTX.app"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ChatGPTX: Build",
      "noDebug": true,
      "autoAttachChildProcesses": false,
      "trace": false,
      "console": "internalConsole",
      "outputCapture": "std",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
